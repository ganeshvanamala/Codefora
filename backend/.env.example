PORT=5000

# Local AI through Ollama. Use this while developing on your own computer.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Hosted AI through GroqCloud. Use this for deployment.
# AI_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
